# AdminPath SaaS Environment Configuration Example

# Server & Application
HOST=0.0.0.0
PORT=3000
APP_SECRET=admitpath-super-secret-key-change-in-production
DB_PATH=admitpath.db

# Cryptography & Token Protection (AES-256-GCM)
DATA_ENCRYPTION_KEY=admitpath-32-byte-encryption-token-demo

# Deliverability Safeguards & Quota Defaults
DAILY_CAP_DEFAULT=25
RAMP_SCHEDULE=20,30,40
MIN_SEND_GAP_SEC=60
MAX_SEND_GAP_SEC=240
TZ_WINDOW_START_HOUR=8
TZ_WINDOW_END_HOUR=17
MAX_BOUNCE_RATE_PERCENT=5.0
FOLLOW_UP_MIN_DAYS=7

# Google OAuth 2.0 (Gmail API Outreach)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Stripe / Payment Provider Webhooks
STRIPE_SECRET_KEY=sk_test_placeholder_key_for_billing
STRIPE_WEBHOOK_SECRET=whsec_placeholder_webhook_signing_secret

# AI Model Provider (Gemini API for tailored drafts)
GEMINI_API_KEY=your-gemini-api-key-here